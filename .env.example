# ─────────────────────────────────────────
#  V-S-STORE — Environment Variables
# ─────────────────────────────────────────

# ── Server ────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Session ───────────────────────────────
SESSION_SECRET=your_super_secret_session_key

# ── Database (MongoDB) ────────────────────
MONGO_URI=mongodb://localhost:27017/vs-store
# Example Atlas URI:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vs-store

# ── Cloudinary (Image Uploads) ────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Redis (BullMQ Job Queues) ─────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# If your Redis instance requires a password:
# REDIS_PASSWORD=your_redis_password

# ── Email (Transactional Mail) ────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false        # true for port 465 (SSL), false for 587 (TLS)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM="V-S-STORE <your_email@gmail.com>"
